# Copy to .env.local and adjust. These variables are read on the server only (BFF, FDEC-03):
# the browser never talks to the API directly and never sees tokens.

# Base URL of the Spring Boot API (no trailing slash)
API_BASE_URL=http://localhost:8080
# Optional: timeout in ms for BFF -> API calls (default 30000)
# API_TIMEOUT_MS=30000
# Optional: timeout in ms for streamed uploads through the BFF (default 300000)
# API_UPLOAD_TIMEOUT_MS=300000
